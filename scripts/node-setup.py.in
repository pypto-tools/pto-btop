#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Install this machine's private pto-btop enrollment bundle and start its agent."""
import argparse
import ctypes
import errno
import hashlib
import http.client
import json
import os
from pathlib import Path, PurePosixPath
import platform
import select
import shutil
import signal
import ssl
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.parse


def run(*command, **kwargs):
    return subprocess.run(command, check=True, **kwargs)


def pidfd_syscall(number, *arguments):
    # Linux uses 434 (pidfd_open) and 424 (pidfd_send_signal) on both supported
    # architectures. Use the kernel ABI when Python was built with older headers.
    # https://github.com/torvalds/linux/blob/v6.6/include/uapi/asm-generic/unistd.h
    # https://github.com/torvalds/linux/blob/v6.6/arch/x86/entry/syscalls/syscall_64.tbl
    if platform.system() != 'Linux' or platform.machine() not in ('x86_64', 'aarch64'):
        raise OSError(errno.ENOSYS, 'Unsupported pidfd platform')
    syscall = ctypes.CDLL(None, use_errno=True).syscall
    syscall.restype = ctypes.c_long
    result = syscall(ctypes.c_long(number), *(ctypes.c_long(value) for value in arguments))
    if result < 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))
    return result


def stop_background_agent(pid, command):
    # A pidfd keeps the signal tied to this process even if its PID is reused.
    try:
        descriptor = os.pidfd_open(pid) if hasattr(os, 'pidfd_open') else pidfd_syscall(434, pid, 0)
    except ProcessLookupError:
        return
    except (AttributeError, OSError) as error:
        raise ValueError('Safe restart requires Linux pidfd support; stop the agent using your service manager and rerun setup.py') from error
    try:
        try:
            actual = Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')[:-1]
        except FileNotFoundError:
            return
        if actual != [arg.encode() for arg in command]:
            raise ValueError('Recorded PID belongs to another command; refusing to stop it')
        try:
            if hasattr(signal, 'pidfd_send_signal'):
                signal.pidfd_send_signal(descriptor, signal.SIGTERM)
            else:
                pidfd_syscall(424, descriptor, signal.SIGTERM, 0, 0)
        except ProcessLookupError:
            return
        if not select.select([descriptor], [], [], 6)[0]:
            raise ValueError('Agent did not stop within 6 seconds; inspect its log before restarting')
    finally:
        os.close(descriptor)


def proxy_url(value):
    message = 'Use an http://, https://, socks5:// or socks5h:// proxy URL with a valid host and port'
    try:
        parsed = urllib.parse.urlsplit(value)
        if (parsed.scheme not in ('http','https','socks5','socks5h') or not parsed.hostname
                or parsed.path not in ('','/') or parsed.query or parsed.fragment
                or any(char.isspace() or ord(char)<32 for char in value)):
            raise ValueError(message)
        if parsed.port is not None and not 1 <= parsed.port <= 65535:
            raise ValueError(message)
    except ValueError as error:
        raise argparse.ArgumentTypeError(message) from error
    return value


def download_release_file(url, destination, limit, proxy=None, no_proxy=False):
    if not url.startswith('https://github.com/pypto-tools/pto-btop/releases/download/'):
        raise ValueError('Unexpected release download URL')
    command = ['curl','--disable','--fail','--silent','--show-error','--location',
               '--proto','=https','--proto-redir','=https','--connect-timeout','15',
               '--max-time','120','--max-filesize',str(limit),
               '--user-agent','pto-btop-node-installer/0.4.0',
               '--output',str(destination),'--url',url]
    if proxy is not None:
        command += ['--proxy',proxy,'--noproxy','']
    elif no_proxy:
        command += ['--proxy','','--noproxy','*']
    # Proxy settings apply only to this download subprocess; never persist them
    # in the node config or forward node credentials to GitHub/the proxy.
    result = subprocess.run(command,stdout=subprocess.DEVNULL,stderr=subprocess.PIPE,text=True)
    if result.returncode:
        # Do not echo curl's command or diagnostics: proxy URLs can contain secrets.
        raise ValueError(f'GitHub download failed (curl exit {result.returncode}); check proxy reachability, network access and TLS trust. Installation stopped.')
    if destination.stat().st_size > limit:
        raise ValueError('Release download exceeds its expected size limit')


def main():
    if sys.version_info < (3, 10):
        raise ValueError('Python 3.10 or newer is required; run this script with an available Python 3.10+ interpreter')
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', type=Path, default=Path.home()/'.local/share/pto-btop')
    parser.add_argument('--bin-dir', type=Path, default=Path.home()/'.local/bin')
    parser.add_argument('--check', action='store_true', help='Check this machine and package without installing or starting')
    parser.add_argument('--install-only', action='store_true', help='Install programs and node configuration without starting')
    parser.add_argument('--restart-agent', action='store_true', help='Restart this node\'s existing agent after installing the update')
    proxy_options = parser.add_mutually_exclusive_group()
    proxy_options.add_argument('--proxy',type=proxy_url,metavar='URL',
                               help='HTTP(S) or SOCKS5 proxy for GitHub downloads; overrides proxy/bypass environment variables')
    proxy_options.add_argument('--no-proxy',action='store_true',
                               help='Download directly, ignoring proxy environment variables')
    args = parser.parse_args()
    if args.restart_agent and (args.check or args.install_only):
        parser.error('--restart-agent cannot be combined with --check or --install-only')
    if not shutil.which('curl'):
        raise ValueError('The curl command is required to download the GitHub release')
    os.umask(0o077)
    bundle = Path(__file__).resolve().parent
    node = json.loads((bundle/'node.json').read_text())
    hub = urllib.parse.urlsplit(node['hub'])
    if hub.scheme != 'https' or not hub.hostname or hub.username or hub.password or hub.path not in ('', '/') or hub.query or hub.fragment:
        raise ValueError('Invalid HTTPS hub URL in node.json')
    arch = {'aarch64': 'arm64', 'x86_64': 'amd64'}.get(platform.machine())
    if platform.system() != 'Linux' or not arch:
        raise ValueError('Requires Linux amd64 or arm64')
    if not shutil.which('ip'):
        raise ValueError('The ip command (iproute2) is required to verify this machine NetBird address')
    interfaces = json.loads(subprocess.check_output(['ip','-j','-4','address','show'],text=True))
    addresses = {address['local'] for interface in interfaces for address in interface.get('addr_info',[]) if address.get('family')=='inet'}
    if node['netbird_ip'] not in addresses:
        raise ValueError(f"This bundle is for {node['id']} ({node['netbird_ip']}); that address is not on this machine. Check NetBird and the bundle name.")
    print('Mode: check only; no installation' if args.check else 'Mode: install and start' if not args.install_only else 'Mode: install only')
    print(f"Node: {node['id']} ({node['netbird_ip']}), architecture: {arch}")
    print('GitHub download route: '+('explicit proxy' if args.proxy is not None else 'direct' if args.no_proxy else 'curl proxy environment'))
    version = '@VERSION@'
    package_name = f'pto-btop-{version}-linux-{arch}'
    wanted = @SHA256@[arch]
    root = Path(os.path.abspath(args.root))
    bindir = Path(os.path.abspath(args.bin_dir))
    config = root/'config/node'
    files = ('agent.json', 'client.json', 'agent.token', 'viewer.token', 'ca.pem')
    if config.is_symlink():
        raise ValueError('Existing node configuration is a symlink; inspect it before installation')
    for name in files:
        existing = config/name
        if existing.is_symlink() or (existing.exists() and existing.read_bytes() != (bundle/'node'/name).read_bytes()):
            raise ValueError(f'Existing {name} differs; refusing to replace an existing enrollment')
    with tempfile.TemporaryDirectory(prefix='pto-btop-install-') as temporary:
        archive = Path(temporary)/f'{package_name}.tar.gz'
        base = f'https://github.com/pypto-tools/pto-btop/releases/download/v{version}'
        for suffix, limit in (('.sha256',4096),('',64*1024*1024)):
            destination = Path(str(archive)+suffix)
            url = f'{base}/{archive.name}{suffix}'
            print('Downloading from GitHub: '+url, flush=True)
            download_release_file(url,destination,limit,args.proxy,args.no_proxy)
        published = archive.with_name(archive.name+'.sha256').read_text().strip().split()
        if published != [wanted,archive.name] or hashlib.sha256(archive.read_bytes()).hexdigest() != wanted:
            raise ValueError('GitHub release checksum mismatch; installation stopped')
        print('GitHub release SHA-256 verified.', flush=True)
        with tarfile.open(archive) as package:
            for member in package.getmembers():
                path = PurePosixPath(member.name)
                if path.is_absolute() or '..' in path.parts or path.parts[0] != package_name:
                    raise ValueError('Invalid archive path')
                if not (member.isdir() or member.isfile() or member.issym()):
                    raise ValueError('Invalid archive member')
                if member.issym() and (path.parent != PurePosixPath(package_name)/'bin' or member.linkname not in ('btop-cluster','btop-agent','btop-server')):
                    raise ValueError('Invalid archive symlink')
            package.extractall(temporary)
        installer = Path(temporary)/package_name/'install.py'
        run(sys.executable, str(installer), '--check')
        if args.check:
            print('Checks passed; no installation, credential copy or service start performed.')
            return
        run(sys.executable, str(installer), '--root', str(root), '--bin-dir', str(bindir))
    config.mkdir(parents=True, exist_ok=True, mode=0o700)
    config.chmod(0o700)
    for name in files:
        target = config/name
        if not target.exists():
            shutil.copyfile(bundle/'node'/name, target)
        target.chmod(0o600)
    binary = root/'app/current/bin/pto-btop-agent'
    command = [str(binary), '--config', str(config/'agent.json')]
    viewer = f'{bindir}/pto-btop --config {config}/client.json'
    if args.install_only:
        print('Installed without starting the agent.')
        print('Start agent: '+' '.join(command))
        print('Open monitor: '+viewer)
        return
    pidfile = root/'state/pto-btop-agent.pid'
    running = False
    if pidfile.exists():
        pid = int(pidfile.read_text().strip())
        proc = Path(f'/proc/{pid}/cmdline')
        if proc.exists():
            actual = proc.read_bytes().split(b'\0')[:-1]
            if actual != [arg.encode() for arg in command]:
                raise ValueError('Recorded PID belongs to another command; inspect the PID file before starting')
            running = True
    restarting_background = running and args.restart_agent
    if restarting_background:
        stop_background_agent(pid, command)
        pidfile.unlink()
        running = False
    has_user_systemd = shutil.which('systemctl') and subprocess.run(
        ['systemctl','--user','show-environment'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode == 0
    if not running and has_user_systemd and not restarting_background:
        units = Path.home()/'.config/systemd/user'
        units.mkdir(parents=True, exist_ok=True)
        target = units/'pto-btop-agent.service'
        content = (root/'app/systemd/pto-btop-agent.service').read_bytes()
        if target.is_symlink() or (target.exists() and target.read_bytes() != content):
            raise ValueError('An existing user service differs; inspect it before replacing')
        target.write_bytes(content)
        run('systemctl','--user','daemon-reload')
        run('systemctl','--user','enable','pto-btop-agent.service')
        run('systemctl','--user','restart' if args.restart_agent else 'start','pto-btop-agent.service')
        print('Agent started as a user systemd service. Persistence after logout depends on the user manager/linger setting.')
    elif not running:
        with (root/'logs/pto-btop-agent.log').open('ab') as log:
            process = subprocess.Popen(command,stdin=subprocess.DEVNULL,stdout=log,stderr=log,start_new_session=True,close_fds=True)
        time.sleep(1)
        if process.poll() is not None:
            raise ValueError(f'Agent exited; inspect {root}/logs/pto-btop-agent.log')
        pidfile.write_text(str(process.pid)+'\n')
        print('Agent started in the background; reboot autostart needs a service manager.')
    else:
        print('The agent is already running with this configuration.')
    print('Open monitor: '+viewer)
    context = ssl.create_default_context(cafile=str(config/'ca.pem'))
    headers = {'Authorization': 'Bearer '+(config/'viewer.token').read_text().strip()}
    last_error = ''
    for attempt in range(12):
        connection = http.client.HTTPSConnection(hub.hostname,hub.port or 443,context=context,timeout=3)
        try:
            connection.request('GET',f"/api/v1/hosts/{urllib.parse.quote(node['id'], safe='')}/snapshot",headers=headers)
            response = connection.getresponse()
            payload = response.read()
            if response.status != 200:
                raise ValueError(f'Hub returned HTTPS status {response.status}')
            status = json.loads(payload)['status']
            if status == 'ONLINE':
                print(f"{node['id']}: ONLINE at {node['hub']}")
                return
            last_error = status
        except (OSError,ValueError,http.client.HTTPException) as error:
            last_error = str(error)
        finally:
            connection.close()
        time.sleep(1)
    raise ValueError('Installed, but the hub has not confirmed ONLINE: '+last_error+'. The agent will retry; check NetBird access to the hub and the agent log.')


if __name__ == '__main__':
    try:
        main()
    except (OSError,ValueError,subprocess.SubprocessError) as error:
        raise SystemExit(str(error)) from error
